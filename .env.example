# ==============================================================================
# Animal Collection - Root Environment Variables Template (Docker Compose)
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env':
#    cp .env.example .env
# 2. Update placeholders with your secure credentials before starting Docker services.
# 3. DO NOT commit your actual '.env' file containing real secrets to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
# Database name and service user
DB_NAME=animal_db
DB_USER=postgres
# Secure password for PostgreSQL. Change this to a strong password for your environment.
DB_PASSWORD=your_secure_db_password_here
# Host port mapping for PostgreSQL (5433 avoids conflict with any local PostgreSQL on 5432)
DB_PORT=5433

# ------------------------------------------------------------------------------
# MinIO Object Storage (S3-compatible)
# ------------------------------------------------------------------------------
# MinIO Root access credentials
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=your_secure_minio_password_here
# Port configurations for API and Web Console
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_DEFAULT_BUCKET=animal-photos

# ------------------------------------------------------------------------------
# Google OAuth 2.0 Configuration
# ------------------------------------------------------------------------------
# Web Client ID from Google Cloud Console > APIs & Services > Credentials
# Format: <client-id>.apps.googleusercontent.com
GOOGLE_WEB_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# Backend Security & JWT
# ------------------------------------------------------------------------------
# Secret key for JWT cryptographic signing (minimum 32 characters / 256 bits)
# Generate a strong key with: openssl rand -hex 32
JWT_SECRET=your_jwt_secret_key_generate_with_openssl_rand_hex_32
