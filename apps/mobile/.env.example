# ==========================================
# Animal Collection - Mobile Environment
# ==========================================
# All client-side environment variables in Expo MUST be prefixed with EXPO_PUBLIC_

# App Environment Mode (development | staging | production)
EXPO_PUBLIC_APP_ENV=development

# ------------------------------------------
# Networking Endpoints
# ------------------------------------------
# Choose endpoint based on your testing environment:
# - Android Emulator: Use 10.0.2.2 (routes back to host machine Docker)
# - Physical Device via USB: Use localhost (requires `adb reverse tcp:8000 tcp:8000` & `adb reverse tcp:9000 tcp:9000`)
# - Production/Staging: Use https://api.yourdomain.com

# Backend REST API Gateway
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000

# MinIO Object Storage (S3 API)
EXPO_PUBLIC_STORAGE_ENDPOINT=http://10.0.2.2:9000
EXPO_PUBLIC_STORAGE_BUCKET=animal-photos

# ------------------------------------------
# Third-party Integrations
# ------------------------------------------
# Web Client ID generated in Google Cloud Console (APIs & Services > Credentials > OAuth 2.0 Client IDs)
# Required by @react-native-google-signin/google-signin
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com