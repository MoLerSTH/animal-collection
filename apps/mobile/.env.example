# ==============================================================================
# Animal Collection - Mobile Application Environment Variables Template
# ==============================================================================
# Instructions:
# 1. Copy this file to 'apps/mobile/.env':
#    cp apps/mobile/.env.example apps/mobile/.env
#
# IMPORTANT SECURITY NOTE:
# All variables prefixed with EXPO_PUBLIC_ are embedded directly into the
# client JavaScript bundle during build time and are VISIBLE TO ANY USER.
# NEVER put private API secrets, database passwords, or JWT secrets in this file!
# ==============================================================================

# Application Environment Mode (development | staging | production)
EXPO_PUBLIC_APP_ENV=development

# Settings: support contact and optional published privacy policy URL
EXPO_PUBLIC_SUPPORT_EMAIL=bike2920@gmail.com
EXPO_PUBLIC_PRIVACY_POLICY_URL=

# ------------------------------------------------------------------------------
# Networking Endpoints
# ------------------------------------------------------------------------------
# Select the appropriate API URL based on your development target:
# - Android Emulator: http://10.0.2.2:8000 (routes back to host machine Docker/backend)
# - iOS Simulator:    http://localhost:8000
# - Physical Device:  http://<YOUR_LOCAL_MACHINE_IP>:8000 (or localhost with `adb reverse tcp:8000 tcp:8000`)
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000

# ------------------------------------------------------------------------------
# MinIO / S3 Object Storage (Client-facing)
# ------------------------------------------------------------------------------
# Publicly reachable endpoint for image downloads/previews
# - Android Emulator: http://10.0.2.2:9000
# - iOS Simulator:    http://localhost:9000
# - Physical Device:  http://<YOUR_LOCAL_MACHINE_IP>:9000
EXPO_PUBLIC_STORAGE_ENDPOINT=http://10.0.2.2:9000
EXPO_PUBLIC_STORAGE_BUCKET=animal-photos

# ------------------------------------------------------------------------------
# Google Sign-In Integration
# ------------------------------------------------------------------------------
# Web Client ID from Google Cloud Console (OAuth 2.0 Web Client)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com
# OAuth client of type iOS, bundle ID com.animalcollection.app (separate from Web client)
# Leave empty to use development login on iOS.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# ------------------------------------------------------------------------------
# EAS Build Configuration
# ------------------------------------------------------------------------------
# Production: use a public HTTPS API; /privacy is served by the backend.
# EAS_PROJECT_ID= (set after linking your Expo account with eas init)
