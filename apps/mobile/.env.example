# ==============================================================================
# Animal Collection - Mobile Application Environment Variables Template
# ==============================================================================
# Instructions:
# 1. Copy this file to 'apps/mobile/.env':
#    cp apps/mobile/.env.example apps/mobile/.env
# 2. Client-side environment variables in Expo MUST be prefixed with EXPO_PUBLIC_
# ==============================================================================

# App Environment Mode (development | staging | production)
EXPO_PUBLIC_APP_ENV=development

# Settings: support contact and optional published privacy policy URL
EXPO_PUBLIC_SUPPORT_EMAIL=bike2920@gmail.com
EXPO_PUBLIC_PRIVACY_POLICY_URL=

# ------------------------------------------------------------------------------
# Networking Endpoints
# ------------------------------------------------------------------------------
# - Android Emulator: Use http://10.0.2.2:8000 (routes back to host machine Docker)
# - iOS Simulator: Use http://localhost:8000
# - Physical Device via USB: Use http://localhost:8000 (requires `adb reverse tcp:8000 tcp:8000`)
# - Physical Device via LAN: Use http://<YOUR_LOCAL_IP>:8000
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000

# MinIO Object Storage (S3 API)
EXPO_PUBLIC_STORAGE_ENDPOINT=http://10.0.2.2:9000
EXPO_PUBLIC_STORAGE_BUCKET=animal-photos

# ------------------------------------------------------------------------------
# Google Sign-In Integration
# ------------------------------------------------------------------------------
# Web Client ID generated in Google Cloud Console
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com
# OAuth client of type iOS, bundle ID com.animalcollection.app (separate from Web client)
# Leave empty to use development login on iOS.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Production: use a public HTTPS API; /privacy is served by the backend.
# EAS_PROJECT_ID= (set after linking your Expo account with eas init)
