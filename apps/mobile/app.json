{
  "expo": {
    "name": "Animal Collection",
    "slug": "animal-collection",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Animal Collection requires camera access to photograph animals."
      },
      "bundleIdentifier": "com.animalcollection.app",
      "buildNumber": "1"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#8E9565",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.animalcollection.app",
      "permissions": [
        "android.permission.CAMERA"
      ],
      "versionCode": 1,
      "allowBackup": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/withAndroidBuildLocale",
      "@react-native-google-signin/google-signin",
      "expo-image",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Add a location to your animal discoveries."
        }
      ],
      "expo-sharing",
      "expo-secure-store",
      "expo-font",
      "./plugins/withAndroidReleaseSigning"
    ]
  }
}
