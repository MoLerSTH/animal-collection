# ==============================================================================
# Animal Collection - Backend API Environment Variables Template
# ==============================================================================
# Instructions:
# 1. Copy this file to 'backend/.env':
#    cp backend/.env.example backend/.env
# 2. Configure credentials before running the backend locally or in containers.
# 3. DO NOT commit your actual '.env' file containing real secrets to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Database Connection (PostgreSQL)
# ------------------------------------------------------------------------------
# Connection string formats:
# - Running inside Docker network: postgresql://<user>:<password>@postgres:5432/<dbname>
# - Running locally on host machine: postgresql://<user>:<password>@localhost:5433/<dbname>
DATABASE_URL=postgresql://postgres:your_secure_db_password_here@postgres:5432/animal_db

# ------------------------------------------------------------------------------
# Google OAuth 2.0 Configuration
# ------------------------------------------------------------------------------
# Web Client ID from Google Cloud Console (used to verify incoming Google ID tokens)
# Format: <client-id>.apps.googleusercontent.com
GOOGLE_WEB_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# JWT Authentication
# ------------------------------------------------------------------------------
# Secret key for JWT cryptographic signing (minimum 32 characters)
# Generate with: openssl rand -hex 32
JWT_SECRET=your_jwt_secret_key_generate_with_openssl_rand_hex_32
# Algorithm used for JWT signing (HS256)
JWT_ALGORITHM=HS256
# Token expiration time in minutes (1440 = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# MinIO / S3 Object Storage Configuration
# ------------------------------------------------------------------------------
# - In Docker network: http://minio:9000
# - On local host: http://localhost:9000
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=your_secure_minio_password_here
S3_BUCKET_NAME=animal-photos

# ------------------------------------------------------------------------------
# Google Gemini Multimodal Vision AI
# ------------------------------------------------------------------------------
# API Key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-lite-latest
AI_WEEKLY_QUOTA_PER_USER=7
AI_DAILY_QUOTA_PER_USER=7

# ------------------------------------------------------------------------------
# Server Environment & Security
# ------------------------------------------------------------------------------
# Application environment mode: 'development', 'staging', or 'production'
ENVIRONMENT=development

# Allowed CORS origins:
# - Development: "*" (or comma-separated URLs like "http://localhost:8081,http://localhost:3000")
# - Production: Specify exact origins, e.g. "https://app.example.com" (NEVER use "*" in production)
CORS_ORIGINS=*
