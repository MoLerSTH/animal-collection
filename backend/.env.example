# ==============================================================================
# Animal Collection - Backend API Environment Variables Template
# ==============================================================================
# Instructions:
# 1. Copy this file to 'backend/.env':
#    cp backend/.env.example backend/.env
# 2. Configure credentials before running the backend locally or in containers.
# ==============================================================================

# ------------------------------------------------------------------------------
# Database Connection
# ------------------------------------------------------------------------------
# In Docker network: postgresql://<user>:<password>@postgres:5432/<dbname>
# In local host dev: postgresql://<user>:<password>@localhost:5433/<dbname>
DATABASE_URL=postgresql://postgres:your_secure_db_password_here@postgres:5432/animal_db

# ------------------------------------------------------------------------------
# Google OAuth 2.0 Configuration
# ------------------------------------------------------------------------------
# Web Client ID from Google Cloud Console (used to verify incoming Google ID tokens)
GOOGLE_WEB_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# JWT Authentication
# ------------------------------------------------------------------------------
# Generate with: openssl rand -hex 32
JWT_SECRET=your_jwt_secret_key_generate_with_openssl_rand_hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# MinIO / S3 Object Storage
# ------------------------------------------------------------------------------
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=your_secure_minio_password_here
S3_BUCKET_NAME=animal-photos

# ------------------------------------------------------------------------------
# Server Environment
# ------------------------------------------------------------------------------
ENVIRONMENT=development
CORS_ORIGINS=*
